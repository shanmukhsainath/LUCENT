# ---------------------------------------------------------------------------
# Database - Supabase
# Copy this file to `.env` and fill in your own project credentials.
#
# Supabase -> Project Settings -> Database -> Connection string
# Choose the "URI" format and pick the POOLER connection (port 6543).
#
#   postgresql://postgres.<PROJECT_REF>:<YOUR_DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?sslmode=require
#
# IMPORTANT notes for Supabase:
#  - Use the pooler host (port 6543) so you do not exhaust the connection limit.
#  - sslmode=require is mandatory; Supabase refuses plaintext connections.
#  - URL-encode special characters in the password (@ : / ? #  -> %40 %3A %2F %3F %23).
#  - Direct connection (port 5432) is only needed for long-lived sessions / LISTEN-NOTIFY.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
ECHO_SQL=false
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Add your deployed frontend origin here when you host it.
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000","http://localhost:5500","http://127.0.0.1:5500"]
STUN_URLS=["stun:stun.l.google.com:19302"]
TURN_URLS=[]
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_SHARED_SECRET=
SPEECH_ENABLED=false
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
LLM_PROVIDER=disabled
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
